+int
+headcount(struct proc *parent)
+{
+  struct proc *p;
+  int n = 0;
+
+  for(p = proc; p < &proc[NPROC]; p++){
+    acquire(&p->lock);
+    if(p->parent == parent && p->state != UNUSED && p->state != ZOMBIE)
+      n++;
+    release(&p->lock);
+  }
+  return n;
+}
